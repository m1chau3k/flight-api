<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="002-create-aircraft-types-table" author="m1chau3k">
        <createTable tableName="aircraft_types">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type_code" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="manufacturer" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="model" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="passenger_capacity" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>